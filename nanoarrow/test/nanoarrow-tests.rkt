#lang racket/base

;; Test suite for the nanoarrow package.
;;
;; Runs against the pyarrow-generated golden fixtures in test/data (see
;; test/generate-fixtures.py and test/interop/README.md). CI does not need
;; pyarrow: all expected values are pinned in test/data/expected.rkt and in
;; the writer-output hashes below.

(require rackunit
         racket/flonum
         racket/file
         racket/string
         racket/runtime-path
         (only-in nanoarrow/private/ffi
                  _ArrowSchema _ArrowArray _ArrowBuffer _ArrowBufferAllocator
                  _ArrowBufferView _ArrowLayout _ArrowSchemaView _ArrowArrayView
                  _ArrowIpcDecoder _ArrowIpcEncoder _ArrowIpcWriter
                  _ArrowIpcOutputStream)
         (only-in ffi/unsafe ctype-sizeof)
         (file "../../test/data/expected.rkt")
         nanoarrow)

;; Golden fixtures live in the repository's test/data directory (they are
;; deliberately not part of the nanoarrow collection proper).
(define-runtime-path data-dir "../../test/data")

(define (data-file name) (path->string (build-path data-dir name)))
(define (read-data name) (file->bytes (data-file name)))

;; flvector->list is not in this Racket version.
(define (flvec->list fv) (for/list ([x (in-flvector fv)]) x))

;; ---------------------------------------------------------------------------
;; Library loading and FFI layout

(test-case "version"
  (define v (nanoarrow-version))
  (check-true (string? v))
  (check-true (string-prefix? v "0.9.")
              (format "bindings target nanoarrow 0.9.x, found ~a" v)))

(test-case "cstruct layouts match the C headers"
  ;; Sizes transcribed from a C sizeof() probe against the 0.9.0 headers
  ;; (macOS arm64 and Linux x86_64 agree on all of these).
  (check-equal? (ctype-sizeof _ArrowSchema) 72)
  (check-equal? (ctype-sizeof _ArrowArray) 80)
  (check-equal? (ctype-sizeof _ArrowBuffer) 48)
  (check-equal? (ctype-sizeof _ArrowBufferAllocator) 24)
  (check-equal? (ctype-sizeof _ArrowBufferView) 16)
  (check-equal? (ctype-sizeof _ArrowLayout) 56)
  (check-equal? (ctype-sizeof _ArrowSchemaView) 144)
  (check-equal? (ctype-sizeof _ArrowArrayView) 200)
  (check-equal? (ctype-sizeof _ArrowIpcDecoder) 56)
  (check-equal? (ctype-sizeof _ArrowIpcEncoder) 8)
  (check-equal? (ctype-sizeof _ArrowIpcWriter) 8)
  (check-equal? (ctype-sizeof _ArrowIpcOutputStream) 24))

;; ---------------------------------------------------------------------------
;; Golden fixtures generated by pyarrow

(define (fields->spec fields)
  (for/list ([f (in-list fields)])
    (list (arrow-field-name f) (arrow-field-type f) (arrow-field-nullable f))))

(define (check-batch-matches! batch num-rows field-specs columns)
  (check-equal? (record-batch-num-rows batch) num-rows)
  (check-equal? (fields->spec (record-batch-fields batch)) field-specs)
  (check-equal? (vector-length (record-batch-columns batch))
                (length field-specs))
  (for ([expected (in-list columns)]
        [got (in-vector (record-batch-columns batch))]
        [field (in-list (record-batch-fields batch))]
        [i (in-naturals)])
    (case (arrow-field-type field)
      [(float32 float64)
       (check-true (flvector? got)
                   (format "column ~a: expected flvector" i))
       (check-equal? (flvec->list got) (flvec->list expected))]
      [else
       (check-true (vector? got) (format "column ~a: expected vector" i))
       (check-equal? (vector->list got) (vector->list expected))])))

(test-case "reader golden: pyarrow file, all supported types"
  (define batch (ipc-file->record-batch (read-data "golden-file-mixed.arrow")))
  (check-batch-matches! batch
                        mixed-num-rows
                        mixed-fields
                        mixed-columns))

(test-case "reader golden: pyarrow stream, all supported types"
  (define batch (ipc-stream->record-batch (read-data "golden-stream-mixed.arrows")))
  (check-batch-matches! batch
                        mixed-num-rows
                        mixed-fields
                        mixed-columns))

(test-case "reader golden: single-column file"
  (define batch (ipc-file->record-batch (read-data "golden-file-single.arrow")))
  (check-batch-matches! batch
                        single-num-rows
                        single-fields
                        single-columns))

(test-case "reader golden: empty batch (0 rows)"
  (define batch (ipc-file->record-batch (read-data "golden-file-empty.arrow")))
  (check-batch-matches! batch
                        empty-num-rows
                        empty-fields
                        empty-columns))

(test-case "reader: multi-batch file returns the first batch"
  (define batch (ipc-file->record-batch (read-data "golden-file-multi-batch.arrow")))
  (check-equal? (record-batch-num-rows batch) 2)
  (check-equal? (vector->list (vector-ref (record-batch-columns batch) 0))
                (list 10 20)))

;; ---------------------------------------------------------------------------
;; Writer output validated against pyarrow (see test/interop/README.md).
;;
;; The two files below are this writer's own output for writer-golden-batch,
;; generated once, decoded with pyarrow, and confirmed to hold exactly the
;; same logical content. The tests pin the writer's byte output (which is
;; deterministic) against these committed fixtures so a regression cannot
;; slip through; pyarrow itself is only needed when regenerating them.

(define writer-file-fixture (read-data "writer-output-file.arrow"))
(define writer-stream-fixture (read-data "writer-output-stream.arrows"))

(define writer-golden-batch
  (record-batch
   mixed-num-rows
   (for/list ([spec (in-list mixed-fields)])
     (arrow-field (list-ref spec 0) (list-ref spec 1) (list-ref spec 2)))
   (list->vector mixed-columns)))

;; ---------------------------------------------------------------------------
;; Writer -> reader round trips

(test-case "round trip: mixed batch through file format"
  (define bytes-out (record-batch->ipc-file writer-golden-batch))
  (define batch (ipc-file->record-batch bytes-out))
  (check-batch-matches! batch mixed-num-rows mixed-fields mixed-columns))

(test-case "round trip: mixed batch through stream format"
  (define bytes-out (record-batch->ipc-stream writer-golden-batch))
  (define batch (ipc-stream->record-batch bytes-out))
  (check-batch-matches! batch mixed-num-rows mixed-fields mixed-columns))

(test-case "round trip: one batch per type, file format"
  (define type-samples
    (list (cons 'bool    (vector #t #f #t))
          (cons 'int8    (vector -1 0 127))
          (cons 'int16   (vector -300 0 32767))
          (cons 'int32   (vector -70000 0 2147483647))
          (cons 'int64   (vector -5000000000 0 9223372036854775807))
          (cons 'uint8   (vector 0 42 255))
          (cons 'uint16  (vector 0 42 65535))
          (cons 'uint32  (vector 0 42 4294967295))
          (cons 'uint64  (vector 0 42 18446744073709551615))
          (cons 'float32 (flvector -1.25 0.0 100.5))
          (cons 'float64 (flvector -2.5 0.1 1e300))
          (cons 'string  (vector "λx.x" "" "wörld ✓"))))
  (for ([pair (in-list type-samples)])
    (define type (car pair))
    (define col (cdr pair))
    (define batch
      (record-batch 3
                    (list (arrow-field "v" type #t))
                    (vector col)))
    (define rt (ipc-file->record-batch (record-batch->ipc-file batch)))
    (check-equal? (record-batch-num-rows rt) 3 (format "~a: rows" type))
    (define got (vector-ref (record-batch-columns rt) 0))
    (if (flvector? col)
        (check-equal? (flvec->list got) (flvec->list col) (format "~a" type))
        (check-equal? (vector->list got) (vector->list col) (format "~a" type)))))

(test-case "round trip: empty batch (0 rows) built by us"
  (define batch
    (record-batch 0
                  (list (arrow-field "n" 'int64 #t)
                        (arrow-field "s" 'string #f))
                  (vector (vector) (vector))))
  (define rt (ipc-file->record-batch (record-batch->ipc-file batch)))
  (check-equal? (record-batch-num-rows rt) 0)
  (check-equal? (length (record-batch-fields rt)) 2))

(test-case "round trip: single-column batch built by us"
  (define batch
    (record-batch 3
                  (list (arrow-field "u16" 'uint16 #t))
                  (vector (vector 1 65535 0))))
  (define rt (ipc-file->record-batch (record-batch->ipc-file batch)))
  (check-batch-matches! rt single-num-rows single-fields single-columns))

(test-case "writer output is deterministic"
  (check-equal? (record-batch->ipc-file writer-golden-batch)
                (record-batch->ipc-file writer-golden-batch)))

;; ---------------------------------------------------------------------------
;; Error handling

(define (check-exn-message! pat thunk)
  (check-exn exn:fail? thunk)
  (with-handlers ([exn:fail? (lambda (e)
                               (check-true (regexp-match? pat (exn-message e))
                                           (format "message ~s did not match ~a"
                                                   (exn-message e) pat)))])
    (thunk)))

(test-case "error: wrong magic"
  (check-exn-message!
   #rx"wrong magic"
   (lambda () (ipc-file->record-batch (bytes-append #"NOPE1" (make-bytes 64 0))))))
(test-case "error: truncated file loses the trailing magic"
  (define full (read-data "golden-file-mixed.arrow"))
  (check-exn-message!
   #rx"truncated or corrupt"
   (lambda () (ipc-file->record-batch (subbytes full 0 (quotient (bytes-length full) 2))))))
(test-case "error: truncated stream mid-message"
  (define full (read-data "golden-stream-mixed.arrows"))
  (check-exn-message!
   #rx"truncated|remaining data|framing"
   (lambda () (ipc-stream->record-batch (subbytes full 0 (quotient (bytes-length full) 2))))))
(test-case "error: empty input"
  (check-exn-message! #rx"wrong magic"
                      (lambda () (ipc-file->record-batch #""))))
(test-case "error: unsupported column type from a pyarrow golden (decimal + list)"
  (check-exn-message!
   #rx"unsupported Arrow type"
   (lambda () (ipc-file->record-batch (read-data "golden-file-unsupported.arrow")))))
(test-case "error: nulls in a pyarrow golden are rejected"
  (check-exn-message!
   #rx"null value"
   (lambda () (ipc-file->record-batch (read-data "golden-file-nulls.arrow")))))
(test-case "error: unsupported type symbol in arrow-field"
  (check-exn exn:fail? (lambda () (arrow-field "x" 'decimal128 #t))))
(test-case "error: column length mismatch"
  (check-exn exn:fail?
             (lambda ()
               (record-batch 3
                             (list (arrow-field "a" 'int32 #t))
                             (vector (vector 1 2))))))
(test-case "error: integer out of range for its type"
  (check-exn exn:fail?
             (lambda ()
               (record-batch 1
                             (list (arrow-field "a" 'int8 #t))
                             (vector (vector 1000))))))
(test-case "error: negative value in an unsigned column"
  (check-exn exn:fail?
             (lambda ()
               (record-batch 1
                             (list (arrow-field "a" 'uint32 #t))
                             (vector (vector -1))))))

;; ---------------------------------------------------------------------------
;; Pinned writer output (byte-identical to the pyarrow-validated fixtures;
;; keep last so failures don't mask the behavioral tests above).

(test-case "pinned writer output bytes"
  (check-equal? (record-batch->ipc-file writer-golden-batch)
                writer-file-fixture
                "writer file output drifted from the pyarrow-validated fixture")
  (check-equal? (record-batch->ipc-stream writer-golden-batch)
                writer-stream-fixture
                "writer stream output drifted from the pyarrow-validated fixture"))
